<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fam_shop_item"
    android:layout_width="250dp"
    android:layout_height="178dp">

    <ImageView
        android:id="@+id/imagefamshopitem_bg"
        android:layout_width="218dp"
        android:layout_height="154dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/families_main_item_little_bg_res" />

    <ImageView
        android:id="@+id/imagefamshopitem"
        android:layout_width="111dp"
        android:layout_height="87dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagefamshopitem_bg"
        app:layout_constraintEnd_toEndOf="@+id/imagefamshopitem_bg"
        app:layout_constraintStart_toStartOf="@+id/imagefamshopitem_bg"
        app:layout_constraintTop_toTopOf="@+id/imagefamshopitem_bg"
        app:srcCompat="@drawable/tuning_icon_box" />

    <TextView
        android:id="@+id/textfamshopitem"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/akrobat_extra_bold"
        android:gravity="center"
        android:text="КЕЙС"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/imagefamshopitem_bg"
        app:layout_constraintStart_toStartOf="@+id/imagefamshopitem_bg"
        app:layout_constraintTop_toTopOf="@+id/imagefamshopitem_bg" />

    <TextView
        android:id="@+id/textfamshopitem2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/akrobat_extra_bold"
        android:gravity="center"
        android:text="80"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView31"
        app:layout_constraintEnd_toEndOf="@+id/imagefamshopitem_bg"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintStart_toEndOf="@+id/imageView31"
        app:layout_constraintTop_toTopOf="@+id/imageView31"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="24dp"
        android:layout_height="19dp"
        app:layout_constraintBottom_toBottomOf="@+id/imagefamshopitem_bg"
        app:layout_constraintEnd_toEndOf="@+id/imagefamshopitem_bg"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintStart_toStartOf="@+id/imagefamshopitem_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.96"
        app:srcCompat="@drawable/families_star_icon_res" />

</androidx.constraintlayout.widget.ConstraintLayout>